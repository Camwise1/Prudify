# Copy to `.env` in the repository root, then fill in.
# `.env` is gitignored -- your password will not be committed.

# --- The image -------------------------------------------------------------
# After your first tagged release, GitHub Actions publishes here.
PRUDIFY_IMAGE=ghcr.io/camwise1/prudify:latest

# --- The SMB share hosting your audiobooks ---------------------------------
# Whatever Windows has mapped to Y:. To find it, run in PowerShell:
#     net use
# and read the "Remote name" column, e.g. \\NAS\Media -> SMB_SERVER=NAS
SMB_SERVER=192.168.1.10
SMB_USER=your-nas-username
SMB_PASSWORD=your-nas-password

# Path *inside* the share. If Y: maps to \\NAS\Media and your books live at
# Y:\Plex\Books\Audiobook, then the value here is Media/Plex/Books/Audiobook
SMB_AUDIOBOOKS_PATH=Media/Plex/Books/Audiobook
SMB_CLEAN_PATH=Media/Plex/Books/Audiobook-Clean

# --- Local storage ---------------------------------------------------------
# Keep this on E:. Your C: drive does not have the room.
PRUDIFY_CONFIG_DIR=E:/PrudifyData/config
